# Server & Access Control Configuration
PORT=8080

# CORS_ORIGINS: Comma-separated allowed origins (supports *, exact origins, or wildcard subdomains like https://*.example.co.nz)
CORS_ORIGINS=*
# CORS_STRICT: When true (and CORS_ORIGINS is not *), actively rejects requests with a disallowed Origin header with 403 Forbidden
CORS_STRICT=false

# API_ACCESS_TOKENS: Optional comma-separated list of active access tokens.
# Leave empty for public access. Specify multiple tokens (e.g. "tok_new_v2,tok_old_v1") for zero-downtime key rotation.
# Clients can pass a token via:
#   - Authorization: Bearer <token>
#   - X-API-Key: <token>
#   - ?api_key=<token>
API_ACCESS_TOKENS=

# Per-IP Rate Limiting
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# Meilisearch Configuration
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=change_me_in_production_min_16_bytes
MEILI_API_KEY=change_me_in_production_min_16_bytes

# LINZ Data Service (LDS) Configuration
# Generate a free API key at https://data.linz.govt.nz/my/api/
LINZ_API_KEY=your_linz_lds_api_key_here
LINZ_BASE_URL=https://data.linz.govt.nz
INGEST_BATCH_SIZE=50000

# Optional local CSV paths (overrides LINZ LDS download when set)
# SUBURBS_CSV_PATH=./testdata/suburbs.csv
# ROADS_CSV_PATH=./testdata/roads.csv
# ADDRESSES_CSV_PATH=./testdata/addresses.csv
